# =============================================================
#   Math Platform — Backend environment template
#   Copy this file to backend/.env and fill in real values.
# =============================================================

# ---------- App ----------
APP_NAME="Math Platform API"
APP_VERSION=0.1.0
DEBUG=false

# ---------- CORS ----------
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS_STR=http://localhost:3000,http://127.0.0.1:3000

# ---------- Database ----------
# SQLite for local dev. Swap to Postgres later with:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# ---------- Auth (Phase 1) ----------
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=1440

# ---------- OCR (Phase 3) ----------
# Options: pix2text (free, open-source), mathpix (paid, best math OCR)
OCR_PROVIDER=pix2text
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ---------- LLM (Phases 4 & 5) ----------
# Options: anthropic, openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
